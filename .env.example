# Copy to .env for local Compose, or paste these variables into Dokploy Environment.
# Generate POSTGRES_PASSWORD with: openssl rand -hex 32
POSTGRES_USER=lernen
POSTGRES_DB=lernen
POSTGRES_PASSWORD=
# Local override only (compose.local.yaml).
WEB_PORT=8088
# Dokploy: replace with your exact HTTPS origin, e.g. https://learn.example.com
ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5187
MAX_ZONE_PLAYERS=128

# Standalone Go development only. Leave DATABASE_URL empty to use JSON persistence.
# DATABASE_URL=postgres://lernen:password@localhost:5432/lernen?sslmode=disable
# DATA_PATH=.data/state.json
# PORT=8097
