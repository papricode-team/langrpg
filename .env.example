# Copy to .env for local Compose, or paste these variables into Dokploy Environment.
# Generate POSTGRES_PASSWORD with: openssl rand -hex 32
POSTGRES_USER=lernen
POSTGRES_DB=lernen
POSTGRES_PASSWORD=
# Local override only (compose.local.yaml).
WEB_PORT=8088
# Dokploy: replace with your exact HTTPS origin, e.g. https://learn.example.com
ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5187
MAX_ZONE_PLAYERS=128
# Dokploy ingress network; isolated deployments use their generated network name.
TRAEFIK_NETWORK=dokploy-network

# Polar billing (server only; never put credentials in VITE_* variables).
# Fill all billing fields together to enable checkout. Production products were
# created in SGK Consulting: EUR 2.99/month and EUR 29.99 one-time lifetime.
POLAR_SERVER=production
PUBLIC_URL=https://langrpg.papricode.com
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_MONTHLY_PRODUCT_ID=a84e62e5-d902-43d9-a659-c00d65bf6209
POLAR_LIFETIME_PRODUCT_ID=7e211030-d059-4bbc-b5a0-9c575c30b42c

# Standalone Go development only. Leave DATABASE_URL empty to use JSON persistence.
# DATABASE_URL=postgres://lernen:password@localhost:5432/lernen?sslmode=disable
# DATA_PATH=.data/state.json
# PORT=8097
# STATIC_DIR=../web/dist
