# Source paintings use LFS. Town and expedition masters moved to LFS on
# 2026-10-15; earlier history still holds them as ordinary blobs.
art/source/*.png filter=lfs diff=lfs merge=lfs -text
art/source/expeditions/*.png filter=lfs diff=lfs merge=lfs -text
art/source/story-cast/*.png filter=lfs diff=lfs merge=lfs -text

# Native-resolution building masters, with exact prompts tracked as ordinary text.
art/source/buildings/*.png filter=lfs diff=lfs merge=lfs -text

# Multi-section high-resolution terrain masters; crop references are regenerated.
art/source/terrain-hd/*-nw.png filter=lfs diff=lfs merge=lfs -text
art/source/terrain-hd/*-ne.png filter=lfs diff=lfs merge=lfs -text
art/source/terrain-hd/*-sw.png filter=lfs diff=lfs merge=lfs -text
art/source/terrain-hd/*-se.png filter=lfs diff=lfs merge=lfs -text
art/source/terrain-detail/*-[0-3]-[0-3].png filter=lfs diff=lfs merge=lfs -text

# New expansion layouts and native detail sections follow the same LFS workflow.
art/source/terrain-expansion/**/*.png filter=lfs diff=lfs merge=lfs -text
art/source/resident-actions/*.png filter=lfs diff=lfs merge=lfs -text

# Shared map-quality masters retain native alpha and exact crop provenance.
art/source/map-quality/*.png filter=lfs diff=lfs merge=lfs -text

# Seamless terrain masters and independent small scenery keep native resolution.
art/source/terrain-materials/*.png filter=lfs diff=lfs merge=lfs -text
art/source/terrain-objects/*.png filter=lfs diff=lfs merge=lfs -text
art/source/terrain-features/*.png filter=lfs diff=lfs merge=lfs -text

# Character voice references for local TTS (scripts/tts); transcripts stay plain text.
art/source/voices/*.wav filter=lfs diff=lfs merge=lfs -text

# Character masters and visual review evidence retain their native resolution.
art/source/character-kit/**/*.png filter=lfs diff=lfs merge=lfs -text
art/source/character-kit/*.png filter=lfs diff=lfs merge=lfs -text
art/source/character-portraits/**/*.png filter=lfs diff=lfs merge=lfs -text
art/source/player-portraits/**/*.png filter=lfs diff=lfs merge=lfs -text
art/proofs/**/*.png filter=lfs diff=lfs merge=lfs -text
art/proofs/*.png filter=lfs diff=lfs merge=lfs -text
art/proofs/**/*.webp filter=lfs diff=lfs merge=lfs -text
art/proofs/*.webp filter=lfs diff=lfs merge=lfs -text
art/proofs/**/*.gif filter=lfs diff=lfs merge=lfs -text
art/proofs/*.gif filter=lfs diff=lfs merge=lfs -text

# Painted animal animation masters and retained generation references.
art/source/animals/*.png filter=lfs diff=lfs merge=lfs -text

# Original public website campaign art.
art/source/marketing/*.png filter=lfs diff=lfs merge=lfs -text
