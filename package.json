{
  "name": "glotworld",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace web",
    "check": "npm run check --workspace web && npm run terrain:check && node scripts/check-item-art.mjs && node scripts/expedition-learning.mjs --check && node scripts/author-minigame-stories.mjs --check && npm run content:check-schema",
    "terrain:prepare": "node scripts/prepare-terrain-materials.mjs && node scripts/prepare-terrain-features.mjs && node scripts/prepare-terrain-objects.mjs",
    "terrain:check": "node scripts/check-terrain-materials.mjs && node scripts/check-terrain-features.mjs && node scripts/check-terrain-objects.mjs",
    "test": "npm run test --workspace web",
    "test:tooling": "node --test 'scripts/*.test.mjs'",
    "verify": "node scripts/verify.mjs",
    "lint": "npm run lint --workspace web",
    "assets": "node scripts/assets.mjs",
    "art": "node scripts/clone-art.mjs",
    "assets:character-features": "node scripts/character-feature-thumbnails.mjs",
    "budgets": "node scripts/check-budgets.mjs",
    "i18n": "node scripts/i18n-coverage.mjs",
    "scenes:check": "node scripts/scene-compiler.mjs check",
    "world:pull": "node scripts/world-sync.mjs pull",
    "world:push": "node scripts/world-sync.mjs push",
    "world:preview": "node scripts/world-preview.mjs",
    "world:view": "node scripts/world-view.mjs",
    "world:mcp": "node tools/world-mcp/server.mjs",
    "worlds:check-expansion": "node docs/audits/measure-living-world-baseline.mjs . --check-expansion",
    "pacing": "node scripts/audit-pacing.mjs",
    "items:plan": "node scripts/item-art-plan.mjs",
    "items:prepare": "node scripts/prepare-item-art.mjs",
    "items:check": "node scripts/check-item-art.mjs",
    "audio:tapes": "node scripts/prepare-minigame-tapes.mjs",
    "content:build": "node scripts/build-content.mjs",
    "content:export": "node scripts/word-map.mjs --export",
    "content:apply": "node scripts/word-map.mjs --apply",
    "content:check": "node scripts/word-map.mjs --check --require-reviewed",
    "release:check": "npm run content:check",
    "content:check-schema": "node scripts/word-map.mjs --check",
    "ui:check": "npm run ui:check --workspace web"
  }
}
