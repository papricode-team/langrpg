---
import SiteLayout from '../layouts/SiteLayout.astro';
import WorldSprite from '../components/WorldSprite.astro';
import { guides } from '../data/guides';
const questions = [
  ['What is glotworld?', 'glotworld is a browser-based German-learning story RPG. Explore painted towns, investigate mysteries and use German to make progress. Conversations, listening, vocabulary review and short written replies are part of the adventure.'],
  ['Can I play if I know no German?', 'Yes. The story starts with short A1-level sentences and guided replies. You can reveal meanings, tap unfamiliar words and ask for help. Optional practice spans A1, A2 and B1; later story chapters become more demanding.'],
  ['Do I need to download anything?', 'No installation is needed. The game runs in your browser on desktop and mobile, with keyboard, click-to-walk and touch controls. A larger screen gives the illustrated world more room. You need an internet connection to play.'],
  ['Is glotworld free to play?', 'Yes. You can keep playing for free by restarting the game for another two hours, as often as you like. Each restart clears your game progress; your account and character stay the same. Your first ten minutes need no signup. To keep playing without progress resets, choose monthly access for €2.99 per month or lifetime access for €29.99 once. Tax is included. Current prices are confirmed in the game before checkout.'],
  ['Will I actually speak German in the game?', 'You read and listen to German, build sentences and type short replies. No microphone is required, and the game does not assess pronunciation or spoken conversation. For speaking confidence, pair your adventures with practice with another person.'],
  ['Can I play with other people?', 'You can see other players exploring the same region. Your story choices and learning progress are your own. Cooperative quests and evidence trading are not currently part of the game.'],
  ['Will this prepare me for a German exam?', 'glotworld offers practice across A1, A2 and B1 topics. It is not an exam, accredited course or CEFR certificate. Use official exam materials and speaking practice if you are preparing for a qualification.'],
];
const towns = [
  { name: 'Lindenhafen', tag: 'ACT I · THE VANISHING RAILWAY', image: 'lindenhafen', text: 'A ticket with your name. A railway slipping out of memory. Your first German words might be the clue everyone needs.', word: 'die Ankunft', meaning: 'the arrival' },
  { name: 'Waldruh', tag: 'ACT II · THE MISSING HOUR', image: 'waldruh', text: 'Beyond the harbor, a forest town has lost an hour. Follow the stories people tell—and the details they leave out.', word: 'die Erinnerung', meaning: 'the memory' },
  { name: 'Nebelstadt', tag: 'ACT III · THE FORGOTTEN NAMES', image: 'nebelstadt', text: 'A lighthouse cuts through the mist. Names disappear in its wake. Find the words for a promise worth keeping.', word: 'das Versprechen', meaning: 'the promise' },
];
const schema = [
  { '@type': 'VideoGame', '@id': 'https://glotworld.com/#game', name: 'glotworld', description: 'A German-learning RPG with an individual story, reading, listening and written practice. Other players are visible in shared regions.', url: 'https://glotworld.com/game/', genre: ['Role-playing', 'Educational'], gamePlatform: 'Web browser', inLanguage: ['de', 'en', 'tr'], playMode: 'https://schema.org/SinglePlayer', image: 'https://glotworld.com/images/glotworld-social.jpg' },
];
---
<SiteLayout title="Learn German by Playing a Story RPG | glotworld" description="Learn German through a world of stories. Explore painted towns, solve mysteries and practise real German in glotworld, a browser RPG with A1–B1 learning activities." schema={schema}>
  <link slot="head" rel="preload" as="image" fetchpriority="high" type="image/avif" href="/images/hero-1920.avif" imagesrcset="/images/hero-960.avif 960w, /images/hero-1920.avif 1920w" imagesizes="100vw" />
  <section class="hero" aria-labelledby="hero-title">
    <picture><source type="image/avif" srcset="/images/hero-960.avif 960w, /images/hero-1920.avif 1920w" sizes="100vw" /><img class="hero-art" src="/images/hero-1920.webp" srcset="/images/hero-960.webp 960w, /images/hero-1920.webp 1920w" sizes="100vw" width="1920" height="1080" alt="A lantern-lit harbor town, a stone bridge and a traveler at the edge of an enchanted forest" fetchpriority="high" /></picture>
    <div class="hero-shade"></div>
    <div class="hero-atmosphere" aria-hidden="true"><span class="hero-fog"></span><span class="hero-sparks"></span><span class="hero-embers"></span><span class="hero-embers hero-embers-far"></span></div>
    <div class="hero-content container">
      <p class="eyebrow"><span class="little-line"></span> A WORLD WORTH FINDING WORDS FOR</p>
      <h1 id="hero-title">A new world.<br />A new adventure.<br /><em>In German.</em></h1>
      <p class="hero-description">Somewhere, a town is forgetting its name.<br class="desktop-break" /> The words you learn could bring it back.</p>
      <div class="hero-actions"><a class="button" href="/game/" data-play>Begin your adventure <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a><a class="text-link light-link" href="#first-words"><span class="play-circle" aria-hidden="true">▷</span> Try your first words</a></div>
      <p class="hero-meta">Learn German through play <span>✧</span> In your browser <span>✧</span> No download</p>
    </div>
    <div class="hero-bottom container"><span>THE LANTERN ATLAS <span class="small-star">✦</span> A LANGUAGE ADVENTURE</span><a href="#welcome">Step into the story <span aria-hidden="true">↓</span></a></div>
    <span class="art-caption">World illustration</span>
  </section>
  <div class="trust-strip"><span>A1–B1 German practice</span><span aria-hidden="true">✧</span><span>3 story towns</span><span aria-hidden="true">✧</span><span>Your choices. Your story.</span><span aria-hidden="true">✧</span><span>Desktop & mobile</span></div>
  <section class="intro-section section container" id="welcome">
    <p class="eyebrow">WELCOME TO GLOTWORLD</p>
    <div class="intro-grid"><h2>Don’t just learn<br />the words.<br /><em>Live the story.</em></h2><div><p class="lead">What if your next German lesson began with a mysterious letter?</p><p>A train is vanishing. A stranger knows your name. And somewhere between your first café order and your next discovery, German becomes something you use.</p><p>Explore a painted world, meet its people and find the words to help them. Every conversation is a small step into the language.</p><a class="text-link" href="/about/">Meet your next adventure <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a></div></div>
    <div class="intro-footnote"><span aria-hidden="true">✧</span> A story RPG for curious people. A German-learning game for the rest of us.</div>
  </section>
  <section class="world-section section" id="world">
    <div class="container"><div class="section-heading"><div><p class="eyebrow">FOLLOW THE LANTERN</p><h2>Three towns.<br /><em>A thousand reasons to stay.</em></h2></div><p>From sunlit canals to forests full of secrets.<br />Find your way, one conversation at a time.</p></div>
      <div class="town-grid">{towns.map((town, i) => <article class="town-card"><img src={`/images/${town.image}.webp`} alt={`Painted story setting of ${town.name}`} width="720" height="600" loading="lazy" /><div class="town-shade"></div><div class="town-copy"><span class="town-number">0{i + 1}</span><div class="town-inhabitants" aria-hidden="true"><WorldSprite kind={i === 1 ? "otto-walk" : "marta-walk"} /><WorldSprite kind={i === 1 ? "marta-walk" : "otto-walk"} /><WorldSprite kind={i === 2 ? "cat" : "chicken"} /></div><p class="eyebrow">{town.tag}</p><h3>{town.name}</h3><p>{town.text}</p><div class="town-word"><span lang="de">{town.word}</span><span>{town.meaning}</span></div></div></article>)}</div>
      <p class="section-caption">Game world artwork · Three story acts, followed by ten optional coastal expeditions</p>
    </div>
  </section>
  <section class="learning-section section container" id="how-to-play">
    <div class="section-heading"><div><p class="eyebrow">THIS IS HOW WORDS BECOME YOURS</p><h2>A little less memorising.<br /><em>A little more meaning.</em></h2></div><a class="text-link" href="/learn-german/learning-german-through-games/">The idea behind the adventure <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a></div>
    <div class="learning-grid"><figure class="game-frame"><div class="game-screen"><img src="/images/gameplay.webp" srcset="/images/gameplay-640.webp 640w, /images/gameplay.webp 1280w" sizes="(max-width: 800px) calc(100vw - 60px), 650px" alt="The glotworld game interface showing a player exploring Lindenhafen and a story objective" width="1280" height="720" loading="lazy" /><video class="game-video" data-gameplay-video muted loop playsinline preload="none" poster="/images/gameplay.webp" width="1280" height="720" aria-hidden="true" disablepictureinpicture><source src="/video/gameplay.webm" type="video/webm" /><source src="/video/gameplay.mp4" type="video/mp4" /></video><button class="video-toggle" type="button" data-video-toggle aria-label="Pause gameplay video" hidden><svg class="icon-pause" aria-hidden="true" viewBox="0 0 24 24"><path d="M8 5v14M16 5v14" /></svg><svg class="icon-play" aria-hidden="true" viewBox="0 0 24 24"><path d="M8 5l11 7-11 7z" /></svg></button></div><figcaption><span class="live-dot"></span> A look inside the adventure <span>Browser gameplay</span></figcaption></figure>
      <div class="learning-steps"><article><span>01</span><div><h3>Explore with a purpose.</h3><p>Follow a clue. Meet a witness. Order something warm. Learn words where they make sense.</p></div></article><article><span>02</span><div><h3>Find your own words.</h3><p>Listen, uncover meanings and try a short German reply. Help is there when you need it.</p></div></article><article><span>03</span><div><h3>Bring them back tomorrow.</h3><p>Revisit words in short reviews. Your learning record helps decide which ones need another encounter.</p></div></article></div>
    </div>
  </section>
  <section class="demo-section section" id="first-words"><div class="container demo-grid"><div class="demo-intro"><p class="eyebrow">YOUR FIRST SIDE QUEST</p><h2>One coffee.<br /><em>A small beginning.</em></h2><p>You’ve arrived at a café in Lindenhafen.<br />The owner smiles. What will you say?</p><p class="small-note">Try a sample conversation. No account. No pressure.</p><a class="text-link light-link" href="/learn-german/ordering-coffee-in-german/">A field guide to café German <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a></div>
      <div class="conversation" data-conversation><div class="cafe-companion"><WorldSprite kind="cat" /></div><div class="conversation-heading"><span class="cafe-icon" aria-hidden="true">☕</span><div><span class="eyebrow">AT THE CAFÉ</span><span>Lindenhafen · A1 sample</span></div><span class="conversation-step" data-step>1 / 2</span></div><p class="dialogue-line" lang="de" data-dialogue>Guten Morgen! Was möchten Sie?</p><details class="translation"><summary>Show the meaning</summary><p data-translation>Good morning! What would you like?</p></details><fieldset class="conversation-answers"><legend data-prompt>You’d like a coffee. Choose your reply.</legend><button type="button" data-answer="coffee"><span lang="de">Einen Kaffee, bitte.</span><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></button><button type="button" data-answer="station"><span lang="de">Wo ist der Bahnhof?</span><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></button><button type="button" data-answer="name"><span lang="de">Ich heiße Alex.</span><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></button></fieldset><p class="conversation-feedback" data-feedback role="status" aria-live="polite">A few words can open a whole conversation.</p><div class="demo-finish" hidden><a class="button" href="/game/" data-play>Find your next conversation <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a><button class="reset-demo" type="button">Try again</button></div><noscript><p><strong lang="de">Einen Kaffee, bitte.</strong> means “A coffee, please.” In this request, <span lang="de">der Kaffee</span> becomes <span lang="de">einen Kaffee</span>. <a href="/learn-german/ordering-coffee-in-german/">Read the full café guide.</a></p></noscript></div>
    </div></section>
  <section class="cast-section section container" aria-labelledby="cast-title"><img class="cast-atmosphere" src="/images/hero-sky.webp" alt="" width="1440" height="810" loading="lazy" /><div class="section-heading"><div><p class="eyebrow">EVERY VOICE HOLDS A CLUE</p><h2 id="cast-title">Meet a stranger.<br /><em>Find a reason to speak.</em></h2></div><p>The people you meet give your German a purpose. A question, a favor, a conversation worth remembering.</p></div><div class="cast-grid">{[{ id: 'inspector', name: 'The inspector', role: 'A mystery to unravel' }, { id: 'elise', name: 'Elise', role: 'A story to uncover' }, { id: 'marta', name: 'Marta', role: 'A conversation to begin' }, { id: 'otto', name: 'Otto', role: 'Another point of view' }].map(person => <figure class="cast-card"><div class="portrait-halo"></div><img src={`/images/sprites/${person.id}-portrait.webp`} alt={`Painted portrait of ${person.name}`} width="256" height="256" loading="lazy" /><figcaption><h3>{person.name}</h3><p>{person.role}</p></figcaption></figure>)}</div></section>
  <section class="journey-section section container"><p class="eyebrow">COME AS YOU ARE</p><div class="section-heading"><h2>Your German.<br /><em>Your next chapter.</em></h2><p>Start with a greeting. Stay for the mystery.<br />Practice grows with you, from A1 to B1.</p></div><div class="level-grid"><article><span class="level">A1</span><h3>The first hello.</h3><p>Meet people, ask simple questions and find your way around. Short lines, meanings on demand and guided replies help you start.</p><a class="text-link" href="/learn-german/german-for-beginners/">Start from the beginning <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a></article><article><span class="level">A2</span><h3>A little more to say.</h3><p>Talk about everyday life, connect ideas and describe what happened. Put familiar words to work in new situations.</p><a class="text-link" href="/learn-german/german-word-order/">Build a better sentence <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a></article><article><span class="level">B1</span><h3>A point of view.</h3><p>Explain a choice, follow a longer passage and give a reason. Explore more demanding language through optional practice.</p><a class="text-link" href="/learn-german/a1-a2-b1-german-levels/">Understand the levels <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a></article></div><p class="section-caption">Practice levels describe the material. glotworld does not award language certificates.</p></section>
  <section class="pricing-section section container" id="pricing" aria-labelledby="pricing-title">
    <div class="section-heading"><div><p class="eyebrow">A LITTLE INVESTMENT. A WORLD TO EXPLORE.</p><h2 id="pricing-title">Start with curiosity.<br /><em>Stay for the adventure.</em></h2></div><p>Play for free with progress resets, or choose a plan to keep your adventure going without starting over.</p></div>
    <div class="pricing-grid">
      <article class="pricing-card" aria-labelledby="trial-title">
        <p class="eyebrow">A FRESH START, ANYTIME</p><h3 id="trial-title">Free play</h3>
        <p class="pricing-amount">€0 <span>to play</span></p>
        <ul><li>Play free as often as you like</li><li>Game resets every 2 hours.</li><li>No payment details needed</li></ul>
        <a class="text-link" href="/game/" data-play>Try the adventure <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a>
      </article>
      <article class="pricing-card" aria-labelledby="monthly-title">
        <p class="eyebrow">ONE MONTH AT A TIME</p><h3 id="monthly-title">Monthly</h3>
        <p class="pricing-amount">€2.99 <span>/ month</span></p>
        <p class="pricing-detail">Room for another chapter, every day.</p>
        <ul><li>Unlimited play without progress resets</li><li>All three story towns</li><li>A1–B1 learning activities</li></ul>
        <p class="pricing-terms">Billed monthly. Cancel anytime.</p>
        <a class="text-link" href="/game/" data-play>Explore with monthly access <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a>
      </article>
      <article class="pricing-card pricing-card-lifetime" aria-labelledby="lifetime-title">
        <p class="eyebrow">ONE PAYMENT. YOUR OWN PACE.</p><h3 id="lifetime-title">Lifetime</h3>
        <p class="pricing-amount">€29.99 <span>once</span></p>
        <p class="pricing-detail">Keep a place in the world.</p>
        <ul><li>Unlimited play without progress resets</li><li>All three story towns</li><li>A1–B1 learning activities</li></ul>
        <p class="pricing-terms">One payment. No subscription.</p>
        <a class="button" href="/game/" data-play>Explore with lifetime access <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a>
      </article>
    </div>
    <p class="section-caption">All prices in EUR, including tax. Start playing, then choose your plan in the game. Current prices are confirmed before checkout.</p>
  </section>
  <section class="journal-section section"><div class="container"><div class="section-heading"><div><p class="eyebrow">THE TRAVELER’S FIELD NOTES</p><h2>A little German.<br /><em>Before you set off.</em></h2></div><a class="text-link" href="/learn-german/">Explore all field notes <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a></div><div class="guide-grid">{guides.slice(0,3).map(guide => <a class="guide-card" href={`/learn-german/${guide.slug}/`}><div class="guide-image"><img src={`/images/${guide.image}.webp`} alt={guide.alt} width="720" height="480" loading="lazy" /><span>{guide.category}</span></div><div class="guide-copy"><p class="eyebrow">{guide.level} <span>·</span> {guide.minutes} MIN READ</p><h3>{guide.title}</h3><p>{guide.description}</p><span class="text-link">Read the field note <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></span></div></a>)}</div></div></section>
  <section class="faq-section section container" id="questions"><div><p class="eyebrow">BEFORE YOU PACK YOUR BAGS</p><h2>A few things<br /><em>you might wonder.</em></h2><p>New world. Fair questions.</p></div><div class="faq-list">{questions.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
  <section class="closing-section"><img class="closing-sky" src="/images/hero-sky.webp" alt="" width="1440" height="810" loading="lazy" /><img src="/images/hero-town-960.webp" srcset="/images/hero-town-960.webp 960w, /images/hero-town.webp 1920w" sizes="100vw" alt="" width="960" height="540" loading="lazy" /><div class="closing-shade"></div><div class="closing-copy"><span class="closing-star" aria-hidden="true">✧</span><p class="eyebrow">YOUR STORY STARTS WITH A WORD</p><h2>The world is waiting.<br /><em>Say hallo.</em></h2><a class="button" href="/game/" data-play>Begin your adventure <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7" /></svg></a><p>In your browser. At your pace. In German.</p></div></section>
</SiteLayout>
<script>
  // Muted gameplay plays only while visible, never under reduced motion or Save-Data,
  // and never before the visitor scrolls to it: preload="none" defers every byte.
  const video = document.querySelector<HTMLVideoElement>('[data-gameplay-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  if (video && toggle && 'IntersectionObserver' in window && !saveData) {
    let visible = false, paused = false;
    const label = () => {
      toggle.setAttribute('aria-label', paused ? 'Play gameplay video' : 'Pause gameplay video');
      toggle.dataset.state = paused ? 'paused' : 'playing';
    };
    const update = () => {
      toggle.hidden = calm.matches;
      if (visible && !paused && !calm.matches) video.play().catch(() => { toggle.hidden = true; });
      else video.pause();
      if (calm.matches) video.classList.remove('is-playing');
    };
    video.addEventListener('playing', () => video.classList.add('is-playing'));
    toggle.addEventListener('click', () => { paused = !paused; label(); update(); });
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; update(); }, { threshold: 0.35 }).observe(video);
    calm.addEventListener('change', update);
    label(); update();
  }
</script>
<script>
  const panel = document.querySelector<HTMLElement>('[data-conversation]');
  if (panel) {
    let step = 0;
    const feedback = panel.querySelector<HTMLElement>('[data-feedback]')!;
    const answers = [...panel.querySelectorAll<HTMLButtonElement>('[data-answer]')];
    const show = (selector: string, text: string) => { panel.querySelector(selector)!.textContent = text; };
    const answerText = (texts: string[]) => answers.forEach((button, i) => { button.querySelector('span')!.textContent = texts[i]; });
    for (const button of answers) button.addEventListener('click', () => {
      const correct = step === 0 ? 'coffee' : 'station';
      if (button.dataset.answer !== correct) {
        feedback.textContent = step === 0 ? (button.dataset.answer === 'station' ? '“Wo ist der Bahnhof?” asks where the station is. Try the reply with Kaffee.' : '“Ich heiße Alex” introduces your name. Try ordering a Kaffee.') : '“Ja, bitte” means “Yes, please.” That is the reply for accepting milk. Give it another try.';
        return;
      }
      if (step === 0) {
        step = 1;
        show('[data-dialogue]', 'Gern! Mit Milch?'); show('[data-translation]', 'Of course! With milk?'); show('[data-step]', '2 / 2');
        show('[data-prompt]', 'You’d like milk. What will you say?');
        answerText(['Auf Wiedersehen.', 'Ja, bitte.', 'Ich komme aus Berlin.']);
        panel.querySelector('details')!.open = false;
        feedback.textContent = 'Exactly! “Einen Kaffee, bitte” is “A coffee, please.” Now the owner asks about milk.';
        answers[0].focus();
      } else {
        show('[data-dialogue]', 'Hier ist Ihr Kaffee. Bitte schön!'); show('[data-translation]', 'Here is your coffee. There you go!');
        feedback.textContent = 'You did it. “Ja, bitte” means “Yes, please.” You’ve just ordered a coffee in German.';
        panel.querySelector<HTMLElement>('fieldset')!.hidden = true;
        panel.querySelector<HTMLElement>('.demo-finish')!.hidden = false;
        panel.querySelector<HTMLAnchorElement>('.demo-finish a')!.focus();
      }
    });
    panel.querySelector('.reset-demo')!.addEventListener('click', () => {
      step = 0; show('[data-dialogue]', 'Guten Morgen! Was möchten Sie?'); show('[data-translation]', 'Good morning! What would you like?'); show('[data-step]', '1 / 2'); show('[data-prompt]', 'You’d like a coffee. Choose your reply.');
      answerText(['Einen Kaffee, bitte.', 'Wo ist der Bahnhof?', 'Ich heiße Alex.']);
      panel.querySelector<HTMLElement>('fieldset')!.hidden = false; panel.querySelector<HTMLElement>('.demo-finish')!.hidden = true; panel.querySelector('details')!.open = false;
      feedback.textContent = 'A few words can open a whole conversation.'; answers[0].focus();
    });
  }
</script>
