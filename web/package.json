{
  "name": "glotworld-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && node ../scripts/check-ui-templates.mjs",
    "ui:check": "node ../scripts/check-ui.mjs",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "phaser": "4.2.1",
    "polygon-clipping": "^0.15.7",
    "earcut": "^3.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.3",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "@typescript/native": "npm:typescript@~7.0.2",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
